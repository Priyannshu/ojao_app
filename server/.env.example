# Copy to .env and fill in. Never commit the real .env.
# Load these into the process environment (pm2 ecosystem, systemd, or a loader).

# Port the Express server listens on (Nginx proxies to this).
PORT=8080

# Path to the Firebase service-account JSON key (Project settings ->
# Service accounts -> Generate new private key). Keep this file off git.
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/ojao/serviceAccount.json

# WhatsApp Cloud API config.
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=1235520376311429
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
