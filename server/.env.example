# Copy to .env and fill in. Never commit the real .env.
# Load these into the process environment (pm2 ecosystem, systemd, or a loader).

# Port the Express server listens on (Nginx proxies to this).
PORT=8080

# Path to the Firebase service-account JSON key (Project settings ->
# Service accounts -> Generate new private key). Keep this file off git.
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/ojao/serviceAccount.json

# Fast2SMS WhatsApp API config. Get the API key from Dashboard -> Dev API and
# the sender/template values from Dashboard -> WhatsApp Manager.
FAST2SMS_API_KEY=your-fast2sms-api-authorization-key
FAST2SMS_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
FAST2SMS_TEMPLATE_NAME=your-approved-utility-template-name
FAST2SMS_TEMPLATE_LANG=en_US
