# ojao API — environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Server ---------------------------------------------------------------
PORT=8081
NODE_ENV=development
# Comma-separated list of allowed CORS origins for the admin dashboard / web
# builds. The mobile app is not a browser origin and does not need this.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) --------------------------------------
# Either set DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgres://ojao:ojao@localhost:5432/ojao
# PGHOST=localhost
# PGPORT=5432
# PGUSER=ojao
# PGPASSWORD=ojao
# PGDATABASE=ojao
# Set to `require` when connecting to a managed provider that mandates TLS.
PGSSLMODE=disable

# --- Auth / JWT -----------------------------------------------------------
# Long random secrets. Rotate on compromise. Access tokens are short-lived;
# refresh tokens are longer-lived and stored server-side (hashed) so they can
# be revoked.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
OTP_HMAC_SECRET=change-me-independent-otp-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- WhatsApp OTP delivery (Fast2SMS) -------------------------------------
FAST2SMS_API_KEY=your-fast2sms-api-authorization-key
FAST2SMS_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
FAST2SMS_TEMPLATE_NAME=your-approved-utility-template-name
FAST2SMS_TEMPLATE_LANG=en_US
OTP_TTL_MS=300000
OTP_RESEND_COOLDOWN_MS=60000
OTP_RATE_WINDOW_MS=3600000
OTP_MAX_SENDS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=5

# --- Discovery / nearby search limits (section 3 server rules) ------------
NEARBY_MAX_RADIUS_METERS=50000
NEARBY_MAX_LIMIT=100
NEARBY_DEFAULT_LIMIT=20

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_NEARBY_MAX=60
RATE_LIMIT_AUTH_MAX=10

# --- Hybrid bridge: mirror approved hospitals into Firestore --------------
# When true, an approved Postgres hospital is also written to Firestore
# `facilities/{sameId}` (+ default departments) so the Firestore-backed mobile
# app shows it. Leave false to run Postgres-only.
FIRESTORE_SYNC_ENABLED=false
# Path to the Firebase service-account JSON (Admin SDK) for the SAME project the
# mobile app uses. Also honored via GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_CREDENTIALS=/home/ubuntu/ojao-api/serviceAccount.json
# Optional explicit project id (usually inferred from the service account).
FIREBASE_PROJECT_ID=
